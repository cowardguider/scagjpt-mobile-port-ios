; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="scag-jpt"
config/version="1.4"
run/main_scene="uid://dixebnqrr5cem"
config/features=PackedStringArray("4.7", "Mobile")
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
config/icon="uid://cq7x6pkq3lwjf"
config/scag/always_play_startup=false
config/scag/initialize_steam=false
config/scag/debug_window_enabled=false
config/scag/always_play_tutorial=true

[audio]

buses/default_bus_layout="uid://cyhbr8w43xods"

[autoload]

Globals="*uid://dt4mul2oevdof"
Util="*uid://b4ccg05yfs1lh"
GameSettings="*uid://3h6yfokkif3"
ScreenBounds="*uid://cb2q3kr2bfo7g"
SteamManager="*uid://dadhxhrp24c5h"
UserConfig="*uid://dwobhnvux44xc"
DialogueManager="*uid://b2h0mqyqjqhic"
Debugger="*uid://cdu7f5olxamld"
ClockManager="*uid://c6ntndjj1jmqp"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=750
window/size/viewport_height=750
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=0
window/version="1.0"

[editor]

run/main_run_args="--rendering-driver vulkan --rendering-method mobile"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/wigglebone/plugin.cfg")

[file_customization]

folder_colors={
"res://!dev/": "gray",
"res://addons/": "blue",
"res://assets/": "green",
"res://assets/music/ringtones/": "red",
"res://code/": "yellow",
"res://interface/": "purple",
"res://objects/": "orange",
"res://resources/": "teal",
"res://scenes/": "pink"
}

[filesystem]

import/blender/enabled=false

[global_group]

DialogueBox="A group for windowed dialogue boxes."

[importer_defaults]

animation_library={
&"animation/fps": 12.0
}

[input]

hold={
"deadzone": 0.2,
