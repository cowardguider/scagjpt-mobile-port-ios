[internationalization]

locale/translations=PackedStringArray("res://localization/text.es.translation", "res://localization/text.en.translation")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
reflections/specular_occlusion/enabled=false
camera/depth_of_field/depth_of_field_bokeh_shape=0
environment/ssao/quality=1
environment/ssil/quality=1
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=5
environment/volumetric_fog/use_filter=0
viewport/transparent_background=false
anti_aliasing/quality/screen_space_aa=2
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
scaling_3d/size/no_focus=false
scaling_3d/volumetric_fog/use_filter=0
scaling_3d/ssil/quality=1
scaling_3d/ssao/quality=1
scaling_3d/depth_of_field/depth_of_field_bokeh_shape=0
anti_aliasing/scale=2.0
viewport/hdr/request_hdr_output=false
